{
  "schemaVersion": 1,
  "id": "adventure_mod",
  "version": "${version}",
  "name": "Story Adventure Mod",
  "description": "A story-driven adventure mod with dimensional bosses, GeckoLib animations, and FTB Quests integration.",
  "authors": ["StoryAdventureDev"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/adventure_mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.example.adventure.AdventureMod"],
    "client": ["com.example.adventure.AdventureModClient"]
  },
  "mixins": [
    "adventure_mod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "fabric-api": ">=0.102.0",
    "geckolib": ">=4.7",
    "java": ">=21"
  },
  "suggests": {
    "ftbquests": "*"
  }
}
